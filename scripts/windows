#!/bin/sh
# The inner loop for working on the triggers: run the walk, print the table,
# render the video. No arguments -- edit a cue, run this, look at the mp4.
#
# An optional leading directory, then any flags for show_windows.py. The directory
# is taken off the argument list with `shift` so it is passed exactly ONCE: the
# earlier `"${1:-dir}" "$@"` passed it twice, and every invocation with an
# argument failed in argparse ("unrecognized arguments", or with a leading flag,
# "track_dir is required").
set -e
cd "$(dirname "$0")/.."
DIR=outputs/track/dual
case "${1:-}" in
  "" | -*) ;;
  *) DIR=$1; shift ;;
esac
PYTHONPATH=src .venv/bin/python scripts/show_windows.py "$DIR" "$@"
